<style>
  .warning-form {
    max-width: 600px;
    margin: 0 auto;
    background: white;
    border-radius: 8px;
    padding: 24px;
    box-shadow: 0 0 10px rgba(0,0,0,0.05);
    font-family: Arial, sans-serif;
  }

  .warning-form h3 {
    margin-bottom: 20px;
    font-size: 20px;
    color: #c53030;
  }

  .form-group {
    margin-bottom: 16px;
  }

  .form-group label {
    display: block;
    font-weight: bold;
    margin-bottom: 6px;
    color: #333;
  }

  .form-group input[type="text"],
  .form-group textarea {
    width: 100%;
    padding: 10px;
    border: 1px solid #ccc;
    border-radius: 6px;
    font-size: 14px;
    box-sizing: border-box;
  }

  .form-actions {
    margin-top: 24px;
    text-align: right;
  }

  .form-actions input[type="submit"] {
    padding: 10px 20px;
    background-color: #dd6b20;
    border: none;
    color: white;
    font-weight: bold;
    border-radius: 6px;
    cursor: pointer;
  }

  .form-actions input[type="submit"]:hover {
    background-color: #c05621;
  }
</style>

<div class="warning-form">
  <h3>⚠️ Gửi cảnh báo đến tác giả: <%= @blog.blogger.username %></h3>

  <%= form_tag send_warning_admin_blog_path(@blog), method: :post do %>
    <div class="form-group">
      <%= label_tag :subject, "Tiêu đề" %>
      <%= text_field_tag :subject, nil, required: true %>
    </div>

    <div class="form-group">
      <%= label_tag :body, "Nội dung cảnh báo" %>
      <%= text_area_tag :body, nil, rows: 6, required: true %>
    </div>

    <div class="form-actions">
      <%= submit_tag "Gửi cảnh báo", class: "button" %>
    </div>
  <% end %>
</div>
