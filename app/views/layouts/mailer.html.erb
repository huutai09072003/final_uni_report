<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8" />
    <style>
      body {
        font-family: Arial, sans-serif;
        background-color: #f4f4f4;
        padding: 20px;
        color: #333;
      }

      .container {
        max-width: 600px;
        margin: 0 auto;
        background: white;
        border-radius: 8px;
        padding: 24px;
        box-shadow: 0 0 10px rgba(0,0,0,0.05);
      }

      .footer {
        margin-top: 24px;
        font-size: 12px;
        color: #999;
        text-align: center;
      }

      a.button {
        display: inline-block;
        padding: 10px 18px;
        background-color: #38a169;
        color: white;
        border-radius: 6px;
        text-decoration: none;
        margin-top: 16px;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <%= yield %>
    </div>

    <div class="footer">
      WasteAI &copy; <%= Time.zone.now.year %> – Bảo vệ môi trường, bảo vệ tương lai.
    </div>
  </body>
</html>
